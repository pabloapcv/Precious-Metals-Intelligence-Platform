# Database — uses absolute path by default; override only if needed
# DATABASE_URL=postgresql://pmip:pmip_dev@localhost:5432/precious_metals

# API Keys (optional — ETL falls back to yfinance where possible)
FRED_API_KEY=your_fred_api_key
POLYGON_API_KEY=your_polygon_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
NEWS_API_KEY=your_news_api_key

# MLflow (file-based by default)
# MLFLOW_TRACKING_URI=file:./mlruns

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
